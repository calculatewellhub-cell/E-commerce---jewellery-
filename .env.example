# Public site URL (used for canonical URLs, sitemap, JSON-LD, UTM links)
NEXT_PUBLIC_SITE_URL=https://www.aureliajewels.com
# WhatsApp business number in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# AI concierge (Claude). Without a key the chat falls back to a built-in rule-based assistant.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-opus-5

# Admin dashboard password (protects /admin and admin APIs)
ADMIN_PASSWORD=change-me

# Social auto-posting. Either use a Make.com / Zapier / n8n webhook (recommended, covers every network)...
SOCIAL_WEBHOOK_URL=
# ...or post directly with the Meta Graph API (Facebook Page + Instagram Business account)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Secret for the cron endpoint that publishes due scheduled posts (/api/social/cron)
CRON_SECRET=
